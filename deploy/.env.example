# Copy to .env on the VPS and fill in. Never commit .env.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Needed for any email (QR passes, receipts, recovery). Unset in production means nothing is sent and an error is logged.
# Verify the domain in Resend (SPF, DKIM), add a _dmarc TXT record, and prefer a subdomain sender. See README.
# Public https origin used in email links, e.g. https://vasbyt.co.za. Without it emails carry no order link.
PUBLIC_BASE_URL=
RESEND_API_KEY=
RESEND_FROM=Vasbyt <geenantwoord@vasbyt.co.za>

# Optional. Unset means the address field is plain Town + Province inputs.
GOOGLE_MAPS_API_KEY=

# Optional. Set both to have an admin account created on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
