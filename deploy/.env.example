# Copy to .env on the VPS and fill in. Never commit .env.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional. Unset means emails are logged to the container log instead of sent.
RESEND_API_KEY=
RESEND_FROM=Vasbyt <geenantwoord@vasbyt.co.za>

# Optional. Unset means the address field is plain Town + Province inputs.
GOOGLE_MAPS_API_KEY=

# Optional. Set both to have an admin account created on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional. Defaults to 1200.
ENTRY_FEE_ZAR=1200
