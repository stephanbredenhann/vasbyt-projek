# Copy to .env on the VPS and fill in. Never commit .env.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Required. The public https origin, no trailing slash, e.g. https://vasbyt.co.za.
# Used for canonical links, social previews, the sitemap and every link in emails.
# Order confirmations and password resets refuse to send without an https value.
PUBLIC_BASE_URL=

# Needed for any email (QR passes, receipts, recovery). Empty means nothing is sent and an error is logged.
# Verify the sending domain in Resend (SPF, DKIM, plus a _dmarc TXT record). See README.
RESEND_API_KEY=
# Must be an address on the domain verified in Resend.
RESEND_FROM=Vasbyt <geenantwoord@vasbyt.co.za>

# Optional. Unset means the address field is plain Town + Province inputs.
GOOGLE_MAPS_API_KEY=

# Optional. Set both to have an admin account created on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
